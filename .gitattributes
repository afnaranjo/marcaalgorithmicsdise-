* text=auto
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.ps1 text eol=crlf
*.sh text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ttf binary
